{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"], // Убрали DOM, так как Node.js работает на сервере
    "module": "esnext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,

    /* Node.js Specific */
    "types": ["node", "vitest/globals"],
    "esModuleInterop": true,
    "allowJs": true,
    "forceConsistentCasingInFileNames": true
    // Убрали jsx, incremental и plugins — они нужны только в tsconfig.app.json
  },
  "include": [
    "vite.config.ts",
    "next.config.mjs", // ДОБАВЛЕНО: чтобы TS видел настройки Next.js
    "./dist/types/**/*.ts",
    "./next-env.d.ts"
  ],
  "exclude": ["./node_modules"]
}
